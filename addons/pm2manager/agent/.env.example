# PM2 Agent - Environment Configuration
#
# The agent runs unchanged on Windows Server and on Linux. Every setting below
# applies to both; the few platform differences are called out where they exist.

# Agent display name (shown by pm2-admin when it lists servers).
# Defaults to the machine hostname when left blank.
AGENT_NAME=

# Bind address. 0.0.0.0 exposes the agent to the network — which is the point,
# but pair it with AGENT_ALLOWED_IPS and/or a firewall rule.
HOST=0.0.0.0

# HTTP port (default: 7003)
PORT=7003

# Shared secret required on every /api request:
#   Authorization: Bearer <token>     or     X-Agent-Token: <token>
# The agent refuses to start without one. install.bat generates a random value.
AGENT_TOKEN=

# Optional comma-separated allowlist of caller IPs (the pm2-admin host).
# Empty = any IP may connect (the token is then the only gate).
# Example: AGENT_ALLOWED_IPS=10.0.0.5,10.0.0.6
AGENT_ALLOWED_IPS=

# Allow pm2-admin to act on this machine's PM2 apps (reload / restart / stop /
# reset counters / delete). Set to false for a strictly read-only agent.
AGENT_ALLOW_ACTIONS=true

# Environment label reported with each app
APP_ENV=Production

# HTTP or HTTPS mode (default: HTTP).
# The token travels in a header — use HTTPS on any untrusted network.
APP_HTTP_MODE=HTTP

# TLS certificate files (required when APP_HTTP_MODE=HTTPS).
# Relative paths resolve against the pm2-agent folder.
CERT_KEY=cert.key
CERT_PATH=cert.crt


# ── Performance ──────────────────────────────────────────────────────────────
# Sensible defaults are built in — everything below is optional.

# How the agent talks to PM2:
#   auto  (default) use the PM2 module's RPC socket when the pm2 module can be
#         found on this machine, otherwise shell out to the pm2 CLI
#   api   always use the RPC socket
#   cli   always spawn `pm2 jlist`
# The RPC path answers in single-digit milliseconds and costs no child process;
# a CLI spawn is a whole Node start-up (~1 s, ~40 MB) for every read. `cli` is
# the escape hatch if the RPC path ever misbehaves, at a real cost per request.
AGENT_PM2_MODE=auto

# Where the pm2 package lives, if the agent cannot find it on its own. Only
# needed for an unusual install layout — `auto` resolves nvm, fnm, Volta and a
# plain `npm i -g` without help.
#PM2_MODULE_PATH=

# gzip responses over AGENT_COMPRESS_MIN_BYTES. App, port and process listings
# compress roughly 10x, which is the difference that matters when pm2-admin
# polls an agent across a WAN. Set to false to send everything uncompressed.
AGENT_COMPRESSION=true
AGENT_COMPRESS_MIN_BYTES=1024

# Cache lifetimes in milliseconds. These bound how often the agent does real
# work no matter how fast it is polled — lower them for fresher numbers, raise
# them to spend less CPU on a busy server.
#AGENT_CACHE_PM2_MS=1000          # PM2 process listing
#AGENT_CACHE_PM2_STALE_MS=8000    # how long a stale listing may be served while refreshing
#AGENT_CACHE_PM2_PATHS_MS=30000   # app log paths (fixed while a process lives)
#AGENT_CACHE_LOAD_MS=2000         # CPU load
#AGENT_CACHE_PORTS_MS=5000        # listening socket table
#AGENT_CACHE_PROCESSES_MS=5000    # full process table — the most expensive probe
#AGENT_CACHE_DESCRIBE_MS=3000     # `pm2 describe` output

# Rows returned by /api/system/processes, highest CPU first.
#AGENT_TOP_PROCESSES=100
